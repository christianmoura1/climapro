# Copie para scripts/r2.env e preencha. Esse arquivo não entra no git.
# A service_role e a chave do R2 ficam só na sua máquina. Não coloque no
# frontend, na Vercel, nem em conversa.

SUPABASE_URL=https://plprhjkkxgmapnbmaaew.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=attachments

# O Account ID aparece no endpoint que a Cloudflare mostra ao criar o token:
# https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=climapro-arquivos

# Domínio público do bucket. Escolha este endereço ANTES de rodar --apply.
# Pode ser https://arquivos.seudominio.com.br ou, para começar,
# https://pub-xxxxxxxx.r2.dev
R2_PUBLIC_BASE_URL=
