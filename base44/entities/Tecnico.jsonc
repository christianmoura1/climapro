{
  "name": "Tecnico",
  "type": "object",
  "properties": {
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa"
    },
    "nome": {
      "type": "string"
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "telefone": {
      "type": "string"
    },
    "especialidade": {
      "type": "string",
      "enum": [
        "refrigeracao",
        "climatizacao",
        "ambos"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "ativo",
        "inativo"
      ],
      "default": "ativo"
    },
    "total_atendimentos": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "empresa_id",
    "nome",
    "email"
  ],
  "rls": {}
}