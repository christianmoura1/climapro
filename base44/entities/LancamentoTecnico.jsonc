{
  "name": "LancamentoTecnico",
  "type": "object",
  "properties": {
    "empresa_id": {
      "type": "string"
    },
    "tecnico_id": {
      "type": "string"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "entrada",
        "despesa"
      ]
    },
    "categoria": {
      "type": "string",
      "enum": [
        "orcamento",
        "reembolso",
        "combustivel",
        "alimentacao",
        "estacionamento",
        "pedagio",
        "outro"
      ]
    },
    "descricao": {
      "type": "string"
    },
    "valor": {
      "type": "number"
    },
    "data_lancamento": {
      "type": "string",
      "format": "date"
    },
    "comprovante_url": {
      "type": "string"
    },
    "chamado_id": {
      "type": "string"
    },
    "pode_editar": {
      "type": "boolean",
      "default": true,
      "description": "Se pode ser editado (ap\u00f3s 24h, n\u00e3o pode)"
    }
  },
  "required": [
    "empresa_id",
    "tecnico_id",
    "tipo",
    "valor"
  ]
}