{
  "name": "PMOC",
  "type": "object",
  "properties": {
    "empresa_id": {
      "type": "string"
    },
    "cliente_id": {
      "type": "string"
    },
    "equipamentos_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs dos equipamentos inclu\u00eddos neste PMOC"
    },
    "tecnico_responsavel_id": {
      "type": "string"
    },
    "periodicidade": {
      "type": "string",
      "enum": [
        "mensal",
        "bimestral",
        "trimestral",
        "semestral",
        "anual"
      ]
    },
    "mes_referencia": {
      "type": "string",
      "format": "date",
      "description": "M\u00eas/ano de refer\u00eancia (YYYY-MM-01)"
    },
    "data_inicio": {
      "type": "string",
      "format": "date"
    },
    "data_execucao_programada": {
      "type": "string",
      "format": "date",
      "description": "Data programada para execu\u00e7\u00e3o pelo t\u00e9cnico"
    },
    "proxima_manutencao": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "aguardando_execucao",
        "em_execucao",
        "aguardando_aprovacao_empresa",
        "aguardando_validacao_cliente",
        "concluido",
        "reaberto",
        "pausado",
        "cancelado"
      ],
      "default": "aguardando_execucao"
    },
    "atividades": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "descricao": {
            "type": "string"
          },
          "concluido": {
            "type": "boolean"
          }
        }
      },
      "description": "Checklist padr\u00e3o de atividades definido pela empresa"
    },
    "observacoes": {
      "type": "string"
    },
    "observacoes_empresa": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es adicionadas pela empresa na revis\u00e3o"
    },
    "motivo_reabertura": {
      "type": "string",
      "description": "Motivo caso PMOC seja reaberto"
    },
    "data_aprovacao_empresa": {
      "type": "string",
      "format": "date-time"
    },
    "aprovado_por": {
      "type": "string",
      "description": "Email de quem aprovou pela empresa"
    },
    "data_validacao_cliente": {
      "type": "string",
      "format": "date-time"
    },
    "validado_por_cliente": {
      "type": "string",
      "description": "Nome de quem validou pelo cliente"
    }
  },
  "required": [
    "empresa_id",
    "cliente_id",
    "periodicidade",
    "mes_referencia"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "tipo_usuario": "admin_global"
          }
        },
        {
          "user_condition": {
            "tipo_usuario": "admin_empresa"
          },
          "data.empresa_id": "{{user.data.empresa_id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "tipo_usuario": "admin_global"
          }
        },
        {
          "$and": [
            {
              "data.empresa_id": "{{user.data.empresa_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "tipo_usuario": "admin_empresa"
                  }
                },
                {
                  "user_condition": {
                    "tipo_usuario": "tecnico"
                  },
                  "data.tecnico_responsavel_id": "{{user.data.tecnico_id}}"
                },
                {
                  "user_condition": {
                    "tipo_usuario": "cliente"
                  },
                  "data.cliente_id": "{{user.data.cliente_id}}"
                }
              ]
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "tipo_usuario": "admin_global"
          }
        },
        {
          "$and": [
            {
              "data.empresa_id": "{{user.data.empresa_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "tipo_usuario": "admin_empresa"
                  }
                },
                {
                  "user_condition": {
                    "tipo_usuario": "tecnico"
                  },
                  "data.tecnico_responsavel_id": "{{user.data.tecnico_id}}"
                }
              ]
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "tipo_usuario": "admin_global"
          }
        },
        {
          "user_condition": {
            "tipo_usuario": "admin_empresa"
          },
          "data.empresa_id": "{{user.data.empresa_id}}"
        }
      ]
    }
  }
}