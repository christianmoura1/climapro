{
  "name": "Equipamento",
  "type": "object",
  "properties": {
    "empresa_id": {
      "type": "string"
    },
    "cliente_id": {
      "type": "string"
    },
    "numero_equipamento": {
      "type": "string",
      "description": "N\u00famero de identifica\u00e7\u00e3o \u00fanico do equipamento"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "ar_condicionado",
        "camara_fria",
        "geladeira",
        "freezer",
        "chiller",
        "outro"
      ]
    },
    "marca": {
      "type": "string"
    },
    "modelo": {
      "type": "string"
    },
    "capacidade": {
      "type": "string",
      "description": "Ex: 12.000 BTUs, 5 TR, 300L"
    },
    "localizacao": {
      "type": "string",
      "description": "Local onde o equipamento est\u00e1 instalado"
    },
    "data_instalacao": {
      "type": "string",
      "format": "date"
    },
    "numero_serie": {
      "type": "string"
    },
    "foto_url": {
      "type": "string",
      "description": "URL da foto do equipamento"
    },
    "ultima_manutencao": {
      "type": "string",
      "format": "date"
    },
    "proxima_manutencao": {
      "type": "string",
      "format": "date"
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "empresa_id",
    "cliente_id",
    "tipo",
    "marca",
    "modelo"
  ],
  "rls": {}
}