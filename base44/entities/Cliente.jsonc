{
  "name": "Cliente",
  "type": "object",
  "properties": {
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa que cadastrou este cliente"
    },
    "nome": {
      "type": "string"
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "telefone": {
      "type": "string"
    },
    "whatsapp": {
      "type": "string"
    },
    "endereco": {
      "type": "string"
    },
    "latitude": {
      "type": "number",
      "description": "Latitude da localiza\u00e7\u00e3o do cliente"
    },
    "longitude": {
      "type": "number",
      "description": "Longitude da localiza\u00e7\u00e3o do cliente"
    },
    "tipo_estabelecimento": {
      "type": "string",
      "enum": [
        "residencial",
        "comercial",
        "industrial",
        "hospitalar",
        "outro"
      ]
    },
    "observacoes": {
      "type": "string"
    },
    "tem_acesso_portal": {
      "type": "boolean",
      "default": false,
      "description": "Se o cliente tem acesso ao portal"
    },
    "documentos": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "nome": {
            "type": "string"
          },
          "tipo": {
            "type": "string",
            "enum": [
              "laudo",
              "contrato",
              "orcamento",
              "pmoc",
              "outro"
            ]
          },
          "url": {
            "type": "string"
          },
          "data_upload": {
            "type": "string",
            "format": "date-time"
          },
          "tecnico_responsavel": {
            "type": "string"
          }
        }
      },
      "description": "Documentos e laudos do cliente"
    }
  },
  "required": [
    "empresa_id",
    "nome",
    "telefone"
  ],
  "rls": {
    "read": null,
    "update": {
      "$or": [
        {
          "user_condition": {
            "tipo_usuario": "admin_global"
          }
        },
        {
          "user_condition": {
            "tipo_usuario": "admin_empresa"
          },
          "data.empresa_id": "{{user.data.empresa_id}}"
        },
        {
          "user_condition": {
            "tipo_usuario": "cliente"
          },
          "data.email": "{{user.email}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "tipo_usuario": "admin_global"
          }
        },
        {
          "user_condition": {
            "tipo_usuario": "admin_empresa"
          },
          "data.empresa_id": "{{user.data.empresa_id}}"
        }
      ]
    }
  }
}