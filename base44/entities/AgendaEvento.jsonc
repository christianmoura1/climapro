{
  "name": "AgendaEvento",
  "type": "object",
  "properties": {
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa"
    },
    "chamado_id": {
      "type": "string",
      "description": "ID do chamado relacionado (se aplic\u00e1vel)"
    },
    "pmoc_id": {
      "type": "string",
      "description": "ID do PMOC relacionado (se aplic\u00e1vel)"
    },
    "cliente_id": {
      "type": "string"
    },
    "tecnico_id": {
      "type": "string"
    },
    "titulo": {
      "type": "string",
      "description": "T\u00edtulo do evento"
    },
    "descricao": {
      "type": "string"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "chamado",
        "pmoc",
        "reuniao",
        "manual"
      ],
      "default": "manual"
    },
    "origem": {
      "type": "string",
      "enum": [
        "manual",
        "automatico",
        "google_calendar"
      ],
      "default": "manual",
      "description": "Origem do evento"
    },
    "data_inicio": {
      "type": "string",
      "format": "date-time",
      "description": "Data e hora de in\u00edcio"
    },
    "data_fim": {
      "type": "string",
      "format": "date-time",
      "description": "Data e hora de t\u00e9rmino"
    },
    "endereco": {
      "type": "string"
    },
    "latitude": {
      "type": "number"
    },
    "longitude": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "pendente",
        "confirmado",
        "em_andamento",
        "concluido",
        "cancelado"
      ],
      "default": "pendente"
    },
    "cor": {
      "type": "string",
      "default": "#3b82f6",
      "description": "Cor do evento no calend\u00e1rio"
    },
    "recorrente": {
      "type": "boolean",
      "default": false,
      "description": "Se \u00e9 um evento recorrente"
    },
    "frequencia_recorrencia": {
      "type": "string",
      "enum": [
        "diaria",
        "semanal",
        "mensal",
        "trimestral",
        "semestral",
        "anual"
      ],
      "description": "Frequ\u00eancia da recorr\u00eancia"
    },
    "google_calendar_event_id": {
      "type": "string",
      "description": "ID do evento no Google Calendar"
    },
    "notificacao_enviada": {
      "type": "boolean",
      "default": false
    },
    "confirmado_por_tecnico": {
      "type": "boolean",
      "default": false
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "empresa_id",
    "cliente_id",
    "titulo",
    "data_inicio"
  ]
}