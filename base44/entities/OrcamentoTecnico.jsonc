{
  "name": "OrcamentoTecnico",
  "type": "object",
  "properties": {
    "empresa_id": {
      "type": "string"
    },
    "tecnico_id": {
      "type": "string"
    },
    "mes_referencia": {
      "type": "string",
      "format": "date",
      "description": "M\u00eas de refer\u00eancia (YYYY-MM-01)"
    },
    "valor_orcamento": {
      "type": "number",
      "description": "Valor do or\u00e7amento mensal"
    },
    "status": {
      "type": "string",
      "enum": [
        "pendente",
        "aprovado",
        "rejeitado"
      ],
      "default": "pendente"
    },
    "data_envio": {
      "type": "string",
      "format": "date-time"
    },
    "data_resposta": {
      "type": "string",
      "format": "date-time"
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "empresa_id",
    "tecnico_id",
    "mes_referencia",
    "valor_orcamento"
  ]
}