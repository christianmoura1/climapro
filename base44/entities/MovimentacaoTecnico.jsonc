{
  "name": "MovimentacaoTecnico",
  "type": "object",
  "properties": {
    "empresa_id": {
      "type": "string"
    },
    "tecnico_id": {
      "type": "string"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "entrada",
        "despesa"
      ]
    },
    "categoria": {
      "type": "string",
      "enum": [
        "reembolso",
        "combustivel",
        "alimentacao",
        "estacionamento",
        "pedagio",
        "outro"
      ]
    },
    "descricao": {
      "type": "string"
    },
    "valor": {
      "type": "number"
    },
    "data_movimentacao": {
      "type": "string",
      "format": "date"
    },
    "comprovante_url": {
      "type": "string"
    },
    "chamado_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pendente",
        "aprovado",
        "rejeitado"
      ],
      "default": "pendente"
    },
    "data_envio": {
      "type": "string",
      "format": "date-time"
    },
    "data_resposta": {
      "type": "string",
      "format": "date-time"
    },
    "motivo_rejeicao": {
      "type": "string"
    },
    "aprovado_por": {
      "type": "string"
    }
  },
  "required": [
    "empresa_id",
    "tecnico_id",
    "tipo",
    "valor"
  ]
}