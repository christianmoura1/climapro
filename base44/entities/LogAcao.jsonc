{
  "name": "LogAcao",
  "type": "object",
  "properties": {
    "empresa_id": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "user_email": {
      "type": "string"
    },
    "tipo_usuario": {
      "type": "string"
    },
    "acao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o da a\u00e7\u00e3o realizada"
    },
    "entidade_afetada": {
      "type": "string",
      "description": "Nome da entidade afetada (Chamado, PMOC, etc)"
    },
    "entidade_id": {
      "type": "string",
      "description": "ID do registro afetado"
    },
    "data_hora": {
      "type": "string",
      "format": "date-time"
    },
    "ip_address": {
      "type": "string"
    },
    "detalhes": {
      "type": "string",
      "description": "Detalhes adicionais da a\u00e7\u00e3o"
    }
  },
  "required": [
    "empresa_id",
    "user_id",
    "acao"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "tipo_usuario": "admin_global"
          }
        },
        {
          "$and": [
            {
              "data.empresa_id": "{{user.data.empresa_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "tipo_usuario": "admin_empresa"
                  }
                },
                {
                  "user_condition": {
                    "tipo_usuario": "tecnico"
                  }
                },
                {
                  "user_condition": {
                    "tipo_usuario": "cliente"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "tipo_usuario": "admin_global"
          }
        },
        {
          "user_condition": {
            "tipo_usuario": "admin_empresa"
          },
          "data.empresa_id": "{{user.data.empresa_id}}"
        }
      ]
    },
    "update": false,
    "delete": {
      "$or": [
        {
          "user_condition": {
            "tipo_usuario": "admin_global"
          }
        },
        {
          "user_condition": {
            "tipo_usuario": "admin_empresa"
          },
          "data.empresa_id": "{{user.data.empresa_id}}"
        }
      ]
    }
  }
}