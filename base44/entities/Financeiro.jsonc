{
  "name": "Financeiro",
  "type": "object",
  "properties": {
    "empresa_id": {
      "type": "string"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "entrada",
        "saida"
      ]
    },
    "categoria": {
      "type": "string",
      "enum": [
        "servico",
        "pecas",
        "combustivel",
        "alimentacao",
        "salario",
        "aluguel",
        "equipamento",
        "outro"
      ]
    },
    "descricao": {
      "type": "string"
    },
    "valor": {
      "type": "number"
    },
    "data_lancamento": {
      "type": "string",
      "format": "date"
    },
    "forma_pagamento": {
      "type": "string",
      "enum": [
        "dinheiro",
        "pix",
        "cartao_credito",
        "cartao_debito",
        "boleto",
        "transferencia"
      ]
    },
    "chamado_id": {
      "type": "string"
    },
    "tecnico_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pendente",
        "pago",
        "cancelado"
      ],
      "default": "pendente"
    }
  },
  "required": [
    "empresa_id",
    "tipo",
    "categoria",
    "valor"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "tipo_usuario": "admin_global"
          }
        },
        {
          "user_condition": {
            "tipo_usuario": "admin_empresa"
          },
          "data.empresa_id": "{{user.data.empresa_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "tipo_usuario": "admin_global"
          }
        },
        {
          "user_condition": {
            "tipo_usuario": "admin_empresa"
          },
          "data.empresa_id": "{{user.data.empresa_id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "tipo_usuario": "admin_global"
          }
        },
        {
          "user_condition": {
            "tipo_usuario": "admin_empresa"
          },
          "data.empresa_id": "{{user.data.empresa_id}}"
        }
      ]
    },
    "write": {
      "$or": [
        {
          "user_condition": {
            "tipo_usuario": "admin_global"
          }
        },
        {
          "user_condition": {
            "tipo_usuario": "admin_empresa"
          },
          "data.empresa_id": "{{user.data.empresa_id}}"
        }
      ]
    }
  }
}