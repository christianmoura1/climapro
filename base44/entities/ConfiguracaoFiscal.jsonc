{
  "name": "ConfiguracaoFiscal",
  "type": "object",
  "properties": {
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa"
    },
    "razao_social": {
      "type": "string"
    },
    "nome_fantasia": {
      "type": "string"
    },
    "cnpj": {
      "type": "string"
    },
    "inscricao_municipal": {
      "type": "string"
    },
    "endereco_completo": {
      "type": "string"
    },
    "cidade": {
      "type": "string"
    },
    "codigo_ibge": {
      "type": "string"
    },
    "email_fiscal": {
      "type": "string",
      "format": "email"
    },
    "aliquota_iss": {
      "type": "number",
      "description": "Porcentagem da al\u00edquota ISS"
    },
    "cnae": {
      "type": "string"
    },
    "regime_tributario": {
      "type": "string",
      "enum": [
        "simples_nacional",
        "lucro_presumido",
        "lucro_real"
      ]
    },
    "provedor_nfse": {
      "type": "string",
      "enum": [
        "nfeio",
        "plugnotas",
        "enotas",
        "prefeitura"
      ],
      "default": "nfeio"
    },
    "token_api_nfse": {
      "type": "string",
      "description": "Token de integra\u00e7\u00e3o com API"
    },
    "emissao_automatica": {
      "type": "boolean",
      "default": false,
      "description": "Emitir automaticamente quando servi\u00e7o finalizado"
    }
  },
  "required": [
    "empresa_id",
    "razao_social",
    "cnpj"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "tipo_usuario": "admin_global"
          }
        },
        {
          "user_condition": {
            "tipo_usuario": "admin_empresa"
          },
          "data.empresa_id": "{{user.data.empresa_id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "tipo_usuario": "admin_global"
          }
        },
        {
          "user_condition": {
            "tipo_usuario": "admin_empresa"
          },
          "data.empresa_id": "{{user.data.empresa_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "tipo_usuario": "admin_global"
          }
        },
        {
          "user_condition": {
            "tipo_usuario": "admin_empresa"
          },
          "data.empresa_id": "{{user.data.empresa_id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "tipo_usuario": "admin_global"
          }
        },
        {
          "user_condition": {
            "tipo_usuario": "admin_empresa"
          },
          "data.empresa_id": "{{user.data.empresa_id}}"
        }
      ]
    }
  }
}