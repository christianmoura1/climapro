{
  "name": "GastoTecnico",
  "type": "object",
  "properties": {
    "empresa_id": {
      "type": "string"
    },
    "tecnico_id": {
      "type": "string"
    },
    "chamado_id": {
      "type": "string"
    },
    "tipo_gasto": {
      "type": "string",
      "enum": [
        "combustivel",
        "alimentacao",
        "pedagio",
        "estacionamento",
        "outro"
      ]
    },
    "valor": {
      "type": "number"
    },
    "data_gasto": {
      "type": "string",
      "format": "date"
    },
    "comprovante_url": {
      "type": "string"
    },
    "descricao": {
      "type": "string"
    },
    "status_aprovacao": {
      "type": "string",
      "enum": [
        "pendente",
        "aprovado",
        "rejeitado"
      ],
      "default": "pendente"
    }
  },
  "required": [
    "empresa_id",
    "tecnico_id",
    "tipo_gasto",
    "valor"
  ]
}