{
  "properties": {
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa \u00e0 qual o usu\u00e1rio pertence"
    },
    "tipo_usuario": {
      "type": "string",
      "enum": [
        "admin_global",
        "admin_empresa",
        "tecnico",
        "cliente"
      ],
      "default": "admin_empresa",
      "description": "Tipo de acesso do usu\u00e1rio"
    },
    "tecnico_id": {
      "type": "string",
      "description": "ID do t\u00e9cnico vinculado (se tipo_usuario = tecnico)"
    },
    "telefone": {
      "type": "string"
    },
    "cpf": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "ativo",
        "inativo"
      ],
      "default": "ativo",
      "description": "Status do usu\u00e1rio"
    },
    "ultimo_acesso": {
      "type": "string",
      "format": "date-time",
      "description": "Data e hora do \u00faltimo acesso"
    }
  },
  "name": "User",
  "type": "object",
  "required": [
    "empresa_id",
    "telefone",
    "cpf"
  ]
}