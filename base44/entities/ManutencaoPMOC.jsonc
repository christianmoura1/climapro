{
  "name": "ManutencaoPMOC",
  "type": "object",
  "properties": {
    "empresa_id": {
      "type": "string"
    },
    "pmoc_id": {
      "type": "string",
      "description": "ID do PMOC relacionado"
    },
    "cliente_id": {
      "type": "string"
    },
    "tecnico_id": {
      "type": "string"
    },
    "equipamentos_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs dos equipamentos inclu\u00eddos"
    },
    "data_programada": {
      "type": "string",
      "format": "date",
      "description": "Data programada para manuten\u00e7\u00e3o"
    },
    "data_execucao": {
      "type": "string",
      "format": "date-time",
      "description": "Data e hora real da execu\u00e7\u00e3o"
    },
    "status": {
      "type": "string",
      "enum": [
        "pendente",
        "em_andamento",
        "aguardando_aprovacao_empresa",
        "aguardando_validacao_cliente",
        "concluida",
        "reaberta",
        "cancelada"
      ],
      "default": "pendente"
    },
    "checklists_por_equipamento": {
      "type": "object",
      "description": "Checklists executados organizados por equipamento_id",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "descricao": {
              "type": "string"
            },
            "concluido": {
              "type": "boolean"
            },
            "observacao": {
              "type": "string"
            }
          }
        }
      }
    },
    "fotos_por_equipamento": {
      "type": "object",
      "description": "Fotos organizadas por equipamento_id",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "observacoes_tecnico": {
      "type": "string"
    },
    "observacoes_empresa": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es da empresa na aprova\u00e7\u00e3o"
    },
    "observacoes_cliente": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es do cliente na valida\u00e7\u00e3o"
    },
    "assinatura_tecnico": {
      "type": "string",
      "description": "Base64 da assinatura do t\u00e9cnico"
    },
    "assinatura_cliente": {
      "type": "string",
      "description": "Base64 da assinatura digital do cliente"
    },
    "nome_responsavel_local": {
      "type": "string",
      "description": "Nome do respons\u00e1vel que assinou no local"
    },
    "nome_cliente_confirmacao": {
      "type": "string"
    },
    "latitude": {
      "type": "number"
    },
    "longitude": {
      "type": "number"
    },
    "endereco": {
      "type": "string"
    },
    "problemas_encontrados": {
      "type": "string"
    },
    "servicos_adicionais": {
      "type": "string"
    },
    "duracao_minutos": {
      "type": "number"
    },
    "data_aprovacao_empresa": {
      "type": "string",
      "format": "date-time"
    },
    "aprovado_por_empresa": {
      "type": "string",
      "description": "Email de quem aprovou pela empresa"
    },
    "data_validacao_cliente": {
      "type": "string",
      "format": "date-time"
    },
    "validado_por_cliente": {
      "type": "string"
    },
    "motivo_reabertura": {
      "type": "string"
    },
    "pdf_url": {
      "type": "string",
      "description": "URL do PDF gerado"
    },
    "lancamento_financeiro_id": {
      "type": "string",
      "description": "ID do lan\u00e7amento financeiro gerado"
    }
  },
  "required": [
    "empresa_id",
    "pmoc_id",
    "cliente_id",
    "data_programada"
  ]
}