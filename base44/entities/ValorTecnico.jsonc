{
  "name": "ValorTecnico",
  "type": "object",
  "properties": {
    "empresa_id": {
      "type": "string"
    },
    "tecnico_id": {
      "type": "string"
    },
    "mes_referencia": {
      "type": "string",
      "format": "date",
      "description": "M\u00eas de refer\u00eancia (YYYY-MM-01)"
    },
    "chamados_executados": {
      "type": "number",
      "default": 0
    },
    "valor_por_chamado": {
      "type": "number",
      "description": "Valor m\u00e9dio por chamado"
    },
    "total_mes": {
      "type": "number",
      "description": "Total do m\u00eas"
    },
    "observacoes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es administrativas"
    }
  },
  "required": [
    "empresa_id",
    "tecnico_id",
    "mes_referencia"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "tipo_usuario": "admin_global"
          }
        },
        {
          "user_condition": {
            "tipo_usuario": "admin_empresa"
          },
          "data.empresa_id": "{{user.data.empresa_id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "tipo_usuario": "admin_global"
          }
        },
        {
          "$and": [
            {
              "data.empresa_id": "{{user.data.empresa_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "tipo_usuario": "admin_empresa"
                  }
                },
                {
                  "user_condition": {
                    "tipo_usuario": "tecnico"
                  },
                  "data.tecnico_id": "{{user.data.tecnico_id}}"
                }
              ]
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "tipo_usuario": "admin_global"
          }
        },
        {
          "user_condition": {
            "tipo_usuario": "admin_empresa"
          },
          "data.empresa_id": "{{user.data.empresa_id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "tipo_usuario": "admin_global"
          }
        },
        {
          "user_condition": {
            "tipo_usuario": "admin_empresa"
          },
          "data.empresa_id": "{{user.data.empresa_id}}"
        }
      ]
    }
  }
}