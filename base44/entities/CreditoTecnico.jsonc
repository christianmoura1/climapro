{
  "name": "CreditoTecnico",
  "type": "object",
  "properties": {
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa"
    },
    "tecnico_id": {
      "type": "string",
      "description": "ID do t\u00e9cnico"
    },
    "valor": {
      "type": "number",
      "description": "Valor do cr\u00e9dito"
    },
    "descricao": {
      "type": "string",
      "description": "Motivo/descri\u00e7\u00e3o do cr\u00e9dito"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "adiantamento",
        "reembolso",
        "orcamento",
        "bonus",
        "outro"
      ],
      "default": "adiantamento"
    },
    "status": {
      "type": "string",
      "enum": [
        "pendente",
        "aprovado",
        "rejeitado"
      ],
      "default": "pendente"
    },
    "data_envio": {
      "type": "string",
      "format": "date-time",
      "description": "Data de envio pela empresa"
    },
    "data_resposta": {
      "type": "string",
      "format": "date-time",
      "description": "Data da resposta do t\u00e9cnico"
    },
    "motivo_rejeicao": {
      "type": "string",
      "description": "Motivo da rejei\u00e7\u00e3o (se aplic\u00e1vel)"
    },
    "origem": {
      "type": "string",
      "default": "empresa"
    },
    "enviado_por_email": {
      "type": "string",
      "description": "Email de quem enviou"
    }
  },
  "required": [
    "empresa_id",
    "tecnico_id",
    "valor",
    "descricao"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "tipo_usuario": "admin_global"
          }
        },
        {
          "user_condition": {
            "tipo_usuario": "admin_empresa"
          },
          "data.empresa_id": "{{user.data.empresa_id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "tipo_usuario": "admin_global"
          }
        },
        {
          "$and": [
            {
              "data.empresa_id": "{{user.data.empresa_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "tipo_usuario": "admin_empresa"
                  }
                },
                {
                  "user_condition": {
                    "tipo_usuario": "tecnico"
                  },
                  "data.tecnico_id": "{{user.data.tecnico_id}}"
                }
              ]
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "tipo_usuario": "admin_global"
          }
        },
        {
          "$and": [
            {
              "data.empresa_id": "{{user.data.empresa_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "tipo_usuario": "admin_empresa"
                  }
                },
                {
                  "$and": [
                    {
                      "user_condition": {
                        "tipo_usuario": "tecnico"
                      },
                      "data.tecnico_id": "{{user.data.tecnico_id}}",
                      "data.status": "pendente"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "tipo_usuario": "admin_global"
          }
        },
        {
          "user_condition": {
            "tipo_usuario": "admin_empresa"
          },
          "data.empresa_id": "{{user.data.empresa_id}}"
        }
      ]
    }
  }
}