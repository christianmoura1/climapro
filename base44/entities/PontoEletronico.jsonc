{
  "name": "PontoEletronico",
  "type": "object",
  "properties": {
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa"
    },
    "tecnico_id": {
      "type": "string",
      "description": "ID do t\u00e9cnico"
    },
    "chamado_id": {
      "type": "string",
      "description": "ID do chamado vinculado (se aplic\u00e1vel)"
    },
    "tipo_registro": {
      "type": "string",
      "enum": [
        "entrada",
        "saida_almoco",
        "retorno",
        "saida_final"
      ],
      "description": "Tipo do registro de ponto"
    },
    "data_hora": {
      "type": "string",
      "format": "date-time",
      "description": "Data e hora do registro"
    },
    "latitude": {
      "type": "number",
      "description": "Latitude da localiza\u00e7\u00e3o"
    },
    "longitude": {
      "type": "number",
      "description": "Longitude da localiza\u00e7\u00e3o"
    },
    "endereco": {
      "type": "string",
      "description": "Endere\u00e7o completo da localiza\u00e7\u00e3o"
    },
    "status": {
      "type": "string",
      "enum": [
        "normal",
        "editado",
        "aprovado_manual"
      ],
      "default": "normal"
    },
    "observacoes": {
      "type": "string"
    },
    "editado_por": {
      "type": "string",
      "description": "Email de quem editou (se aplic\u00e1vel)"
    },
    "foto_comprovante": {
      "type": "string",
      "description": "URL da foto do momento do registro"
    }
  },
  "required": [
    "empresa_id",
    "tecnico_id",
    "tipo_registro",
    "data_hora",
    "latitude",
    "longitude"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "tipo_usuario": "admin_global"
          }
        },
        {
          "$and": [
            {
              "data.empresa_id": "{{user.data.empresa_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "tipo_usuario": "admin_empresa"
                  }
                },
                {
                  "user_condition": {
                    "tipo_usuario": "tecnico"
                  },
                  "data.tecnico_id": "{{user.data.tecnico_id}}"
                }
              ]
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "tipo_usuario": "admin_global"
          }
        },
        {
          "$and": [
            {
              "data.empresa_id": "{{user.data.empresa_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "tipo_usuario": "admin_empresa"
                  }
                },
                {
                  "user_condition": {
                    "tipo_usuario": "tecnico"
                  },
                  "data.tecnico_id": "{{user.data.tecnico_id}}"
                }
              ]
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "tipo_usuario": "admin_global"
          }
        },
        {
          "$and": [
            {
              "data.empresa_id": "{{user.data.empresa_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "tipo_usuario": "admin_empresa"
                  }
                },
                {
                  "user_condition": {
                    "tipo_usuario": "tecnico"
                  },
                  "data.tecnico_id": "{{user.data.tecnico_id}}",
                  "data.status": "aguardando_aprovacao"
                }
              ]
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "tipo_usuario": "admin_global"
          }
        },
        {
          "user_condition": {
            "tipo_usuario": "admin_empresa"
          },
          "data.empresa_id": "{{user.data.empresa_id}}"
        }
      ]
    }
  }
}