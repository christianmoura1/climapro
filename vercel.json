{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/LandingPage",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/Dashboard", "destination": "/__app" },
    { "source": "/Chamados", "destination": "/__app" },
    { "source": "/Clientes", "destination": "/__app" },
    { "source": "/PMOC", "destination": "/__app" },
    { "source": "/Financeiro", "destination": "/__app" },
    { "source": "/Welcome", "destination": "/__app" },
    { "source": "/AdminPanel", "destination": "/__app" },
    { "source": "/SetupInicial", "destination": "/__app" },
    { "source": "/Planos", "destination": "/__app" },
    { "source": "/Equipamentos", "destination": "/__app" },
    { "source": "/TecnicoDashboard", "destination": "/__app" },
    { "source": "/GerenciarTecnicos", "destination": "/__app" },
    { "source": "/ClienteDashboard", "destination": "/__app" },
    { "source": "/CompanySettings", "destination": "/__app" },
    { "source": "/NotasFiscais", "destination": "/__app" },
    { "source": "/LegacyFallback", "destination": "/__app" },
    { "source": "/ValorTecnicos", "destination": "/__app" },
    { "source": "/Agenda", "destination": "/__app" },
    { "source": "/PontoEletronico", "destination": "/__app" },
    { "source": "/EquipamentoDetalhes", "destination": "/__app" },
    { "source": "/AlterarSenha", "destination": "/__app" },
    { "source": "/InitialChoice", "destination": "/__app" },
    { "source": "/Login", "destination": "/__app" },
    { "source": "/Orcamentos", "destination": "/__app" },
    { "source": "/Estoque", "destination": "/__app" },
    { "source": "/e/:id", "destination": "/__app" },
    { "source": "/orcamento/:token", "destination": "/__app" }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
